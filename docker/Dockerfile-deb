# The Debian-Based Build (Optional Fallback)
# If for any reason your enterprise environment blocks external EPEL RPMs 
# and you don't have librdkafka mirrored in your internal Red Hat Satellite, 
# you can fall back to the Debian version (which includes librdkafka in its core repos).

# STAGE 1: Builder
FROM golang:1.26.4-bookworm AS builder
RUN apt-get update && apt-get install -y git gcc librdkafka-dev
RUN go install go.k6.io/xk6/cmd/xk6@latest
WORKDIR /build
RUN CGO_ENABLED=1 xk6 build --with github.com/mostafa/xk6-kafka/v2@v2.1.0

# STAGE 2: Runtime
FROM debian:bullseye-slim
RUN apt-get update && apt-get install -y ca-certificates librdkafka1 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash k6user
USER k6user
WORKDIR /home/k6user
COPY --from=builder /build/k6 /usr/local/bin/k6
COPY ./tests/kafka-perf-framework.js /home/k6user/kafka-perf-framework.js
ENTRYPOINT ["k6"]